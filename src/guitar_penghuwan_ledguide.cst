// HC-05 data UART: Dock J8 pin 11 = PMOD1_IO0 (module TXD),
// J8 pin 12 = PMOD1_IO1 (module RXD). Both are 3.3V signals.
IO_LOC "bt_rx" Y21;
IO_PORT "bt_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "bt_tx" Y22;
IO_PORT "bt_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
// Dock 31005 schematic: J8.9 PMOD1_IO2=AB21, J8.10 PMOD1_IO3=AB22.
// Dedicated ADS7828 bus; panel J1.3=SDA/J1.4=SCL, 3.3V pull-ups on panel.
IO_LOC "panel_sda" AB21;
IO_LOC "panel_scl" AB22;
IO_PORT "panel_sda" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4 BANK_VCCIO=3.3;
IO_PORT "panel_scl" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4 BANK_VCCIO=3.3;

// External standard I2S on unused PMOD0/J9 contacts. Existing keyboard uses
// J9.5/R18, J9.6/T18 and J9.8/R17. Check the DAC module's own supply/straps.
IO_LOC "i2s_bclk" P16;
IO_LOC "i2s_lrclk" U21;
IO_LOC "i2s_dout" T21;
IO_LOC "i2s_xsmt" R19;
IO_PORT "i2s_bclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_PORT "i2s_lrclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_PORT "i2s_dout" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_PORT "i2s_xsmt" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;

// Verified NEO 31005 onboard TF slot: no extra wiring.
IO_LOC "sd_miso" AA15;
IO_LOC "sd_clk" V15;
IO_LOC "sd_cs" W15;
IO_LOC "sd_mosi" Y16;
IO_PORT "sd_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "sd_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_PORT "sd_cs" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4 BANK_VCCIO=3.3;
IO_PORT "sd_mosi" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
