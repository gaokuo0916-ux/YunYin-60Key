IO_LOC "sys_clk" V22;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
// Board K0/KEY0, reused from the original audio60k.cst (1.5V bank).
IO_LOC "key0_n" AA13;
IO_PORT "key0_n" IO_TYPE=LVCMOS15 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=1.5;
// Dock J9: pin 6 = PMOD0_IO7, pin 5 = PMOD0_IO6, pin 8 = PMOD0_IO5.
IO_LOC "key_load_n" T18;
IO_LOC "key_clk" R18;
IO_LOC "key_data" R17;
IO_PORT "key_load_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "key_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "key_data" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// J16 drives the onboard pixel; its DOUT is available on Dock J24 pin 3.
IO_LOC "led_data" J16;
IO_PORT "led_data" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// NEO Dock PT8211 DAC -> onboard HEADPHONE jack, no extra wires.
IO_LOC "hp_bck" Y17;
IO_LOC "hp_ws" AB17;
IO_LOC "hp_din" AA16;
IO_LOC "pa_en" AB16;
IO_PORT "hp_bck" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "hp_ws" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "hp_din" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "pa_en" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

