<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="cn.fpga.score" android:versionCode="28" android:versionName="2.6.6">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="云音曲谱" android:theme="@style/YunYinTheme" android:icon="@drawable/app_icon"
                 android:allowBackup="false" android:supportsRtl="true" android:usesCleartextTraffic="false" android:extractNativeLibs="true">
        <activity android:name=".ImageImportActivity" android:exported="false" android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".ScoreBrowserActivity" android:exported="false" android:configChanges="orientation|screenSize|keyboardHidden|uiMode" />
        <provider android:name=".PhotoProvider" android:authorities="cn.fpga.score.photos" android:exported="false" android:grantUriPermissions="true" />
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop" android:windowSoftInputMode="adjustResize" android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/midi" /><data android:mimeType="audio/x-midi" /><data android:mimeType="audio/mid" />
                <data android:mimeType="application/vnd.recordare.musicxml" /><data android:mimeType="application/vnd.recordare.musicxml+xml" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/midi" /><data android:mimeType="audio/x-midi" /><data android:mimeType="text/plain" />
                <data android:mimeType="image/*" /><data android:mimeType="audio/mid" />
                <data android:mimeType="application/vnd.recordare.musicxml" /><data android:mimeType="application/vnd.recordare.musicxml+xml" />
            </intent-filter>
        </activity>
    </application>
</manifest>
